# ============================================================
# PUBLIC SITE IDENTITY
# Safe to expose in browser/client bundles.
# ============================================================

NEXT_PUBLIC_SITE_NAME="Suman Media"
NEXT_PUBLIC_LEGAL_NAME="Your Company Legal Name"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_ALLOW_INDEXING=false


# ============================================================
# SANITY CONTENT LAKE / STUDIO
# Public Sanity configuration
# ============================================================

NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2026-08-21"
NEXT_PUBLIC_SANITY_STUDIO_PREVIEW_URL="http://localhost:3000"


# ============================================================
# SANITY SERVER-ONLY SECRETS
# Never prefix these with NEXT_PUBLIC_
# Put real values only in .env.local / Netlify Environment Variables
# ============================================================

SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=


# ============================================================
# DATABASE
# Real database URL belongs only in .env.local / Netlify
# ============================================================

DATABASE_URL=


# ============================================================
# CLOUDFLARE TURNSTILE
# ============================================================

NEXT_PUBLIC_TURNSTILE_SITE_KEY=

TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES="localhost"


# ============================================================
# AWS PRIVATE RESUME STORAGE
# Server-only credentials
# ============================================================

AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_PRIVATE_BUCKET=


# ============================================================
# OPTIONAL PUBLIC MEDIA ORIGIN
# ============================================================

NEXT_PUBLIC_MEDIA_BASE_URL=


# ============================================================
# REQUEST PRIVACY / RATE LIMITING
# Server-only secret
# ============================================================

IP_HASH_SECRET=


# ============================================================
# PRODUCTION SAFETY
# Keep false locally.
# Set true in production environment where required.
# ============================================================

ENFORCE_PRODUCTION_ENV=false