# Public site identity
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Suman Media & Entertainment"
NEXT_PUBLIC_LEGAL_NAME="Suman Entertainment & Media Pvt. Ltd."
NEXT_PUBLIC_ALLOW_INDEXING=true

# Sanity Content Lake / Studio
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-21
NEXT_PUBLIC_SANITY_STUDIO_PREVIEW_URL=http://localhost:3000
# Server-only Viewer token. Never prefix with NEXT_PUBLIC_ and never expose client-side.
SANITY_API_READ_TOKEN=replace-with-a-sanity-viewer-token
SANITY_REVALIDATE_SECRET=replace-with-a-random-secret-at-least-32-characters

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/suman_media
DATABASE_POOL_MAX=5

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-site-key
TURNSTILE_SECRET_KEY=your-secret-key
TURNSTILE_ALLOWED_HOSTNAMES=localhost

# AWS private resume storage
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_PRIVATE_BUCKET=your-private-bucket

# Optional public media origin
NEXT_PUBLIC_MEDIA_BASE_URL=

# Request privacy / rate limiting
IP_HASH_SECRET=replace-with-a-random-secret-at-least-32-characters

# Production-only safety gate
ENFORCE_PRODUCTION_ENV=false
