generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SubmissionStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  SPAM
  ARCHIVED
}

enum ApplicationStatus {
  RECEIVED
  REVIEWING
  SHORTLISTED
  REJECTED
  HIRED
}

model ContactSubmission {
  id        String           @id @default(cuid())
  requestId String
  name      String
  email     String
  phone     String?
  company   String?
  subject   String?
  message   String
  sourceUrl String?
  ipHash    String?
  userAgent String?
  status    SubmissionStatus @default(NEW)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([requestId])
}

model NewsletterSubscription {
  id             String    @id @default(cuid())
  email          String    @unique
  isActive       Boolean   @default(true)
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
  updatedAt      DateTime  @updatedAt
}

model CareerApplication {
  id             String            @id @default(cuid())
  requestId      String
  jobReference   String
  applicantName  String
  email          String
  phone          String?
  resumeKey      String
  resumeFileName String
  coverLetter    String?
  ipHash         String?
  userAgent      String?
  status         ApplicationStatus @default(RECEIVED)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([jobReference, createdAt])
  @@index([status, createdAt])
  @@index([email])
  @@index([requestId])
}
