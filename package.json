{
  "name": "suman-media",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "prisma generate && tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed:countries": "node --experimental-strip-types scripts/seed-country-calling-codes.ts",
    "db:studio": "prisma studio",
    "predev": "prisma generate",
    "prebuild": "prisma generate",
    "sanity:studio": "sanity dev",
    "sanity:deploy": "sanity deploy",
    "sanity:schema": "sanity schema extract --path schema.json",
    "sanity:typegen": "npm run sanity:schema && sanity typegen generate",
    "sanity:typegen:watch": "sanity typegen generate --watch",
    "sanity:validate": "sanity documents validate",
    "cms:check": "npm run sanity:typegen && npm run typecheck",
    "sanity:backup": "sh infrastructure/scripts/backup-sanity.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@react-three/fiber": "^9.3.0",
    "@sanity/image-url": "^2.1.1",
    "dotenv": "^17.0.0",
    "framer-motion": "^13.1.1",
    "gsap": "^3.13.0",
    "lenis": "^1.3.26",
    "matter-js": "^0.20.0",
    "next": "16.2.12",
    "next-sanity": "^13.3.2",
    "pg": "^8.16.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanity": "^6.10.1",
    "styled-components": "^6.1.19",
    "three": "^0.179.1",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^22",
    "@types/pg": "^8.15.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.179.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prisma": "^7.0.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "@octokit/request": "10.0.14"
  },
  "packageManager": "npm@10.9.2"
}
