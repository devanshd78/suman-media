NODE_ENV=production
ENFORCE_PRODUCTION_ENV=true

NEXT_PUBLIC_SITE_URL=https://www.example.com
NEXT_PUBLIC_SITE_NAME="Suman Media & Entertainment"
NEXT_PUBLIC_LEGAL_NAME="Suman Entertainment & Media Pvt. Ltd."
NEXT_PUBLIC_ALLOW_INDEXING=true

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-21
NEXT_PUBLIC_SANITY_STUDIO_PREVIEW_URL=https://www.example.com
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=replace-with-a-long-random-secret-at-least-32-characters

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_MEDIA_BASE_URL=https://media.example.com

POSTGRES_USER=suman_media
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=suman_media
DATABASE_POOL_MAX=5
DATABASE_URL=postgresql://suman_media:URL_ENCODED_PASSWORD@postgres:5432/suman_media

TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=example.com,www.example.com

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_PRIVATE_BUCKET=

IP_HASH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
